# ─── Letheans env ─── copy to .env.local (local) or export in the environment.
# Missing values = site runs in DEMO MODE (no crash, submissions disabled).

# Public base URL of the site (used for OpenGraph). e.g. https://letheans.xyz
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Auth (X OAuth 2.0, same names as the Next.js app) ──
# Random secret: `openssl rand -base64 32`
AUTH_SECRET=
# Canonical URL of the site. X callback = {AUTH_URL}/api/auth/callback/twitter
AUTH_URL=http://localhost:3000

# ── X (Twitter) OAuth 2.0 ── developer.x.com → Project → App → User authentication settings
# Type: Web App (confidential client), OAuth 2.0 on. Scopes used: users.read tweet.read offline.access
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Optional: server-side X task verification (needs paid X API access, Basic tier+) ──
ENABLE_X_TASK_VERIFICATION=false
X_BEARER_TOKEN=

# ── Google Sheets (service account) ──
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key, keep the \n, wrap in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Tab name (auto-created with header row if missing)
GOOGLE_SHEET_TAB=Applications

# ── Privacy ── salt for hashing IP / user-agent (raw IP is never stored). Random long string.
IP_HASH_SALT=

# ── Optional: Upstash Redis for distributed rate limiting (falls back to in-memory) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rust server only (not in the Next.js app). Default 3000. ──
PORT=3000
